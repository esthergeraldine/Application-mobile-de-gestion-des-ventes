<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VenteJour.Views.Controls"
             x:Class="VenteJour.Views.AideArticlePage"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="20,8,20,24" Spacing="14">
                <controls:BackHeader Titre="Aide" />

                <Label Text="{Binding Article.CategorieTitre}" TextColor="{DynamicResource MintAccent}" FontSize="13" FontAttributes="Bold" />
                <Label Text="{Binding Article.Titre}" Style="{StaticResource TitleLabel}" FontSize="24" />
                <Label Text="{Binding Article.Resume}" Style="{StaticResource MutedLabel}" FontSize="16" />
                <Label Text="{Binding MessageErreur}" IsVisible="{Binding ADesErreur}" Style="{StaticResource ErrorLabel}" />

                <VerticalStackLayout Spacing="12" Margin="0,6,0,0" BindableLayout.ItemsSource="{Binding Article.Paragraphes}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Label Text="{Binding .}" Style="{StaticResource BodyLabel}" FontSize="16" LineHeight="1.25" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNav Grid.Row="1" Actif="profil" />
    </Grid>
</ContentPage>
