<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VenteJour.Views.Controls"
             x:Class="VenteJour.Views.Controls.VenteFormFields">
    <!-- Hérite du BindingContext de la page (NouvelleVente / VentePerte) -->
    <VerticalStackLayout Spacing="10">

        <Label Text="Article" Style="{StaticResource FieldLabel}" FontSize="20" />
        <controls:SelectField Placeholder="Choisir un article" TitreMenu="Choisir un article"
                              ItemsSource="{Binding Produits}" CheminAffichage="Nom"
                              SelectedItem="{Binding ProduitSelectionne, Mode=TwoWay}"
                              Icone="{Binding ProduitSelectionne.Icone, Converter={StaticResource IconKey}}" />

        <Label Text="Quantité" Style="{StaticResource FieldLabel}" FontSize="20" Margin="0,8,0,0" />
        <Border Style="{StaticResource InputBorder}" Padding="0" HeightRequest="56">
            <Grid ColumnDefinitions="64,*,64">
                <Label Text="–" FontSize="28" TextColor="{DynamicResource TitleColor}"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DecrementerCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Column="1" Text="{Binding Quantite}" FontSize="24" FontAttributes="Bold"
                       TextColor="{DynamicResource TextDark}"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                <Label Grid.Column="2" Text="+" FontSize="28" TextColor="{DynamicResource TitleColor}"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding IncrementerCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="20" Margin="0,10,0,0">
            <Border BackgroundColor="{DynamicResource MintBg}" StrokeThickness="0" Padding="16,14">
                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="2">
                    <Label Text="Prix d'achat" Style="{StaticResource TitleLabel}" FontSize="15" />
                    <Label Text="{Binding PrixAchatTexte}" Style="{StaticResource TitleLabel}" FontSize="22" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" BackgroundColor="{DynamicResource MintBg}" StrokeThickness="0" Padding="16,14">
                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="2">
                    <Label Text="Prix de vente" Style="{StaticResource TitleLabel}" FontSize="15" />
                    <Label Text="{Binding PrixVenteTexte}" Style="{StaticResource TitleLabel}" FontSize="22" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </VerticalStackLayout>
</ContentView>
