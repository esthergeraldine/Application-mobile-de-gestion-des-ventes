<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VenteJour.Views.Controls.BottomNav">
    <Grid RowDefinitions="1,Auto" BackgroundColor="White">
        <BoxView HeightRequest="1" Color="#E2E8F0" />

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" Padding="0,8,0,10">

            <!-- Accueil -->
            <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                <Border x:Name="PillAccueil" WidthRequest="56" HeightRequest="32" StrokeThickness="0" BackgroundColor="Transparent">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <Image Source="ico_home_g" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label x:Name="LblAccueil" Text="Accueil" FontSize="12" TextColor="#006652" HorizontalOptions="Center" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAccueil" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <!-- Produits -->
            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                <Border x:Name="PillProduits" WidthRequest="56" HeightRequest="32" StrokeThickness="0" BackgroundColor="Transparent">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <Image Source="ico_chart_g" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label x:Name="LblProduits" Text="Produits" FontSize="12" TextColor="#006652" HorizontalOptions="Center" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProduits" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <!-- Vente (bouton orange central) -->
            <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                <Border WidthRequest="64" HeightRequest="34" StrokeThickness="0" BackgroundColor="#F28C28">
                    <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                    <Image Source="ico_plus_w" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="Vente" FontSize="12" FontAttributes="Bold" TextColor="#006652" HorizontalOptions="Center" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVente" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <!-- Historique -->
            <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                <Border x:Name="PillHistorique" WidthRequest="56" HeightRequest="32" StrokeThickness="0" BackgroundColor="Transparent">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <Image Source="ico_history_g" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label x:Name="LblHistorique" Text="Historique" FontSize="12" TextColor="#006652" HorizontalOptions="Center" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHistorique" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>

            <!-- Profil -->
            <VerticalStackLayout Grid.Column="4" Spacing="2" HorizontalOptions="Center">
                <Border x:Name="PillProfil" WidthRequest="56" HeightRequest="32" StrokeThickness="0" BackgroundColor="Transparent">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <Image Source="ico_person_g" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label x:Name="LblProfil" Text="Profil" FontSize="12" TextColor="#006652" HorizontalOptions="Center" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProfil" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentView>
