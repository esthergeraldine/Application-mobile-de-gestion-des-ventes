<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VenteJour.Views.Controls.SelectField">
    <!--
        Champ de sélection unique et réutilisable.
        Cause du bug précédent : la flèche était une Image dans une colonne séparée du Picker,
        donc sans lien avec lui. Ici le Picker (invisible, Opacity 0) couvre TOUTE la zone du champ,
        au-dessus de l'icône, du texte et de la flèche : n'importe quel appui ouvre le menu natif.
    -->
    <Border x:Name="Cadre" Style="{StaticResource InputBorder}" Padding="8,0" HeightRequest="56">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Border x:Name="Tuile" WidthRequest="40" HeightRequest="40" StrokeThickness="0" VerticalOptions="Center"
                    BackgroundColor="{DynamicResource TileBg}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Image x:Name="IconeImage" WidthRequest="24" HeightRequest="24"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label x:Name="ValeurLabel" Grid.Column="1" Style="{StaticResource TitleLabel}" FontSize="16"
                   VerticalOptions="Center" LineBreakMode="TailTruncation" IsVisible="False" />
            <Label x:Name="PlaceholderLabel" Grid.Column="1" Style="{StaticResource MutedLabel}" FontSize="16"
                   VerticalOptions="Center" LineBreakMode="TailTruncation" />

            <Image Grid.Column="2" Source="ico_chevron_down_g" WidthRequest="26" HeightRequest="26" VerticalOptions="Center" />

            <!-- Doit rester le DERNIER enfant : il est au-dessus de tout et capte tous les appuis -->
            <Picker x:Name="Selecteur" Grid.ColumnSpan="3" Opacity="0" BackgroundColor="Transparent"
                    HorizontalOptions="Fill" VerticalOptions="Fill"
                    SelectedIndexChanged="OnSelecteurChange" />
        </Grid>
    </Border>
</ContentView>
