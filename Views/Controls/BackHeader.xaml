<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VenteJour.Views.Controls.BackHeader">
    <Grid HeightRequest="56">
        <Label x:Name="TitreLabel" Style="{StaticResource TitleLabel}" FontSize="24"
               HorizontalOptions="Center" VerticalOptions="Center" />
        <Grid WidthRequest="48" HeightRequest="48" HorizontalOptions="Start" VerticalOptions="Center">
            <Image Source="ico_arrow_back_g" WidthRequest="30" HeightRequest="30"
                   HorizontalOptions="Center" VerticalOptions="Center" />
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBack" />
            </Grid.GestureRecognizers>
        </Grid>
    </Grid>
</ContentView>
