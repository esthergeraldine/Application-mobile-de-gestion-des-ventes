<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VenteJour.Views.Controls.AppHeader">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Padding="0,10,0,6">
        <Image Source="logo_icon" WidthRequest="44" HeightRequest="44" VerticalOptions="Center" />

        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
            <Label Text="VenteJour" Style="{StaticResource TitleLabel}" FontSize="24" />
            <Label x:Name="SousTitreLabel" Style="{StaticResource MutedLabel}" IsVisible="False" />
        </VerticalStackLayout>

        <Image Grid.Column="2" Source="ico_bell_k" WidthRequest="28" HeightRequest="28" VerticalOptions="Center">
            <Image.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnNotifications" />
            </Image.GestureRecognizers>
        </Image>

        <Border Grid.Column="3" WidthRequest="44" HeightRequest="44" StrokeThickness="0"
                BackgroundColor="{DynamicResource BrandGreen}" VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="22" />
            </Border.StrokeShape>
            <Image Source="ico_person_w" WidthRequest="26" HeightRequest="26"
                   HorizontalOptions="Center" VerticalOptions="Center" />
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnProfil" />
            </Border.GestureRecognizers>
        </Border>
    </Grid>
</ContentView>
