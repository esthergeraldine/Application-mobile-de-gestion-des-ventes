<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VenteJour.Views.Controls"
             x:Class="VenteJour.Views.SignalerProblemePage"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="20,8,20,24" Spacing="6">
                <controls:BackHeader Titre="Signaler un problème" />
                <Label Text="Aidez-nous à comprendre ce qui ne fonctionne pas." Style="{StaticResource MutedLabel}" FontSize="15" />
                <Label Text="Type de problème" Style="{StaticResource FieldLabel}" FontSize="16" Margin="0,6,0,0" />
                <controls:SelectField Placeholder="Choisir un type" TitreMenu="Type de problème" Icone="ico_warning_g"
                                      ItemsSource="{Binding Types}" SelectedItem="{Binding Type, Mode=TwoWay}" />
                <Label Text="{Binding ErreurType}" IsVisible="{Binding ErreurType, Converter={StaticResource NotEmpty}}" Style="{StaticResource ErrorLabel}" />
                <Label Text="Description" Style="{StaticResource FieldLabel}" FontSize="16" Margin="0,6,0,0" />
                <Border Style="{StaticResource InputBorder}" HeightRequest="140" Padding="12,6">
                    <Editor Placeholder="Que s'est-il passé ? Que faisiez-vous ?" Text="{Binding Description}" Style="{StaticResource FieldEditor}" />
                </Border>
                <Label Text="{Binding ErreurDescription}" IsVisible="{Binding ErreurDescription, Converter={StaticResource NotEmpty}}" Style="{StaticResource ErrorLabel}" />
                <Label Text="Date du problème" Style="{StaticResource FieldLabel}" FontSize="16" Margin="0,6,0,0" />
                <Border Style="{StaticResource InputBorder}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Image Source="ico_calendar_g" WidthRequest="26" HeightRequest="26" VerticalOptions="Center" />
                        <DatePicker Grid.Column="1" Date="{Binding DateProbleme}" MaximumDate="{Binding DateMax}" Format="dd/MM/yyyy"
                                    TextColor="{DynamicResource TextDark}" BackgroundColor="Transparent" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Label Text="{Binding ErreurDate}" IsVisible="{Binding ErreurDate, Converter={StaticResource NotEmpty}}" Style="{StaticResource ErrorLabel}" />
                <Label Text="Référence de transaction (facultatif)" Style="{StaticResource FieldLabel}" FontSize="16" Margin="0,6,0,0" />
                <Border Style="{StaticResource InputBorder}">
                    <Entry Placeholder="ex. TRX002" Text="{Binding ReferenceTransaction}" Style="{StaticResource FieldEntry}" />
                </Border>
                <Label Text="{Binding ErreurReference}" IsVisible="{Binding ErreurReference, Converter={StaticResource NotEmpty}}" Style="{StaticResource ErrorLabel}" />
                <Label Text="Pièce jointe (facultatif)" Style="{StaticResource FieldLabel}" FontSize="16" Margin="0,6,0,0" />
                <Border Style="{StaticResource InputBorder}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Image Source="ico_attach_g" WidthRequest="26" HeightRequest="26" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Joindre une capture d'écran" Style="{StaticResource MutedLabel}" FontSize="15"
                               VerticalOptions="Center" IsVisible="{Binding APieceJointe, Converter={StaticResource Inverse}}" />
                        <Label Grid.Column="1" Text="{Binding PieceJointeNom}" Style="{StaticResource TitleLabel}" FontSize="15"
                               VerticalOptions="Center" LineBreakMode="MiddleTruncation" IsVisible="{Binding APieceJointe}" />
                        <Grid Grid.Column="2" WidthRequest="44" HeightRequest="44" IsVisible="{Binding APieceJointe}">
                            <Image Source="ico_close_k" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RetirerPieceJointeCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ChoisirPieceJointeCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <Border BackgroundColor="{DynamicResource MintBg}" StrokeThickness="0" Padding="14,12" Margin="0,8,0,0"
                        IsVisible="{Binding MessageSucces, Converter={StaticResource NotEmpty}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label Text="{Binding MessageSucces}" Style="{StaticResource TitleLabel}" FontSize="15" FontAttributes="None" />
                </Border>
                <Border BackgroundColor="{DynamicResource DangerBg}" StrokeThickness="0" Padding="14,12" Margin="0,8,0,0"
                        IsVisible="{Binding MessageErreur, Converter={StaticResource NotEmpty}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label Text="{Binding MessageErreur}" Style="{StaticResource ErrorLabel}" FontSize="15" />
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource BrandGreen}" />
                <Button Text="Envoyer le signalement" ImageSource="ico_check_w" Style="{StaticResource PrimaryButton}"
                        Command="{Binding EnvoyerCommand}" IsEnabled="{Binding PasOccupe}" Margin="0,10,0,0" />
            </VerticalStackLayout>
        </ScrollView>

        <controls:BottomNav Grid.Row="1" Actif="profil" />
    </Grid>
</ContentPage>
