<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="VenteJour.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:VenteJour.Views"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.TabBarIsVisible="False">

    <ShellContent Route="splash" ContentTemplate="{DataTemplate views:SplashPage}" />
    <ShellContent Route="connexion" ContentTemplate="{DataTemplate views:ConnexionPage}" />
    <ShellContent Route="inscription" ContentTemplate="{DataTemplate views:InscriptionPage}" />
    <ShellContent Route="accueil" ContentTemplate="{DataTemplate views:AccueilPage}" />
    <ShellContent Route="produits" ContentTemplate="{DataTemplate views:ProduitsPage}" />
    <ShellContent Route="historique" ContentTemplate="{DataTemplate views:HistoriquePage}" />
    <ShellContent Route="profil" ContentTemplate="{DataTemplate views:ProfilPage}" />
</Shell>
