# .gitignore for Visual Studio / .NET / .NET MAUI projects

# Ignore Visual Studio temporary files, build results, and
# files generated by popular Visual Studio add-ons.
.vs/
.vscode/
Generated\ Files/

# User-specific files
*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates

# Build folders
[Bb]in/
[Oo]bj/
bin/
obj/

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# Visual Studio cache
*.cache
*.log
*.vsix

# Rider
.idea/
*.sln.iml

# NuGet
*.nupkg
packages/
.nuget/
project.lock.json
project.fragment.lock.json
artifacts/

# Azure Pipelines
.vscode/

# Sonar
.sonar/

# User secrets
secrets.json
secrets.*

# Publish outputs
publish/

# Test results
TestResults/
*.trx
*.TestResult.xml

# Coverage
coverage.opencover.xml
coverage/*

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Logs
*.log

# Temporary files
*.tmp
*.temp
*.cache
*.pid
*.seed

# Certificate / provisioning
*.p12
*.cer
*.mobileprovision

# MAUI / Android / iOS specific
# Android
local.properties
.gradle/
**/obj/**/android/**
**/bin/**/android/**
**/obj/**/**/*-android/**/*
**/bin/**/**/*-android/**/*
*.keystore
*.jks
*.so

# iOS / Mac Catalyst / Mac
**/obj/**/ios/**
**/bin/**/ios/**
*.xcuserstate
*.xcworkspace
xcuserdata/
DerivedData/
*.xcodeproj/project.xcworkspace/

# Windows Phone / UWP
AppPackages/
Package.StoreAssociation.xml

# Xamarin / MAUI generated
*.g.cs
*.g.i.cs

# Rider caches and settings
.idea/
*.sln.iml

# Node / npm (if used in project)
node_modules/

# Optional: lock files generated by IDEs/tooling that you don't want in repo
*.userprefs

# End of file
