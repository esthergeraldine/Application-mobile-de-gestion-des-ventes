<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:VenteJour.Helpers"
             xmlns:styles="clr-namespace:VenteJour.Resources.Styles"
             x:Class="VenteJour.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <styles:ColorsLight />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <helpers:FcfaConverter x:Key="Fcfa" />
            <helpers:NombreConverter x:Key="Nombre" />
            <helpers:IconKeyConverter x:Key="IconKey" />
            <helpers:RangCouleurConverter x:Key="RangCouleur" />
            <helpers:IconKeyBlancConverter x:Key="IconKeyBlanc" />
            <helpers:NotEmptyConverter x:Key="NotEmpty" />
            <helpers:InverseBoolConverter x:Key="Inverse" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
